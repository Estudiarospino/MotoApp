// Prisma schema — ver docs/PROYECTO.md para el contexto de negocio completo.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== USUARIO Y SESIONES ====================
// Diseñado desde ya para 1 usuario, pero sin cerrar la puerta a roles.

enum RolUsuario {
  ADMIN
}

model Usuario {
  id           String     @id @default(cuid())
  email        String     @unique
  nombre       String
  passwordHash String
  rol          RolUsuario @default(ADMIN)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sesiones Sesion[]
}

model Sesion {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

// ==================== CLIENTE Y MOTOCICLETA ====================

enum TipoIdentificacion {
  CC
  CE
  PASAPORTE
  NIT
  OTRO
}

model Cliente {
  id                   String             @id @default(cuid())
  nombreCompleto       String
  tipoIdentificacion   TipoIdentificacion @default(CC)
  numeroIdentificacion String             @unique
  telefono             String?
  email                String?
  direccion            String?
  notas                String?
  activo               Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  contratos  Contrato[]
  prestamos  Prestamo[]
  documentos Documento[]
}

enum EstadoMoto {
  DISPONIBLE
  EN_CONTRATO
  VENDIDA
}

model Motocicleta {
  id            String     @id @default(cuid())
  marca         String
  modelo        String
  placa         String     @unique
  color         String?
  anioModelo    Int?
  precioInicial Int
  estado        EstadoMoto @default(DISPONIBLE)
  fotoUrl       String?
  notas         String?

  /// Fecha de expedición — el vencimiento se calcula (ver src/lib/moto-documentos.ts), nunca se guarda.
  soatFechaExpedicion          DateTime? @db.Date
  /// Fecha de expedición — el vencimiento se calcula (ver src/lib/moto-documentos.ts), nunca se guarda.
  tecnomecanicaFechaExpedicion DateTime? @db.Date

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  contratos Contrato[]
  gastos    Gasto[]
  prestamos Prestamo[]
}

// ==================== CONTRATO ====================

enum EstadoContrato {
  ACTIVO
  FINALIZADO_PAGADO
  FINALIZADO_COMPRADO
  INCUMPLIDO_RECUPERADA
}

/// SOLO informativo (para tener presente cada cuánto paga el cliente) — nunca entra al motor de cierre,
/// que siempre trabaja con `arriendoFijoMensual` sin importar la frecuencia real de los abonos.
enum FrecuenciaPago {
  DIARIO
  SEMANAL
  QUINCENAL
  MENSUAL
}

model Contrato {
  id    String @id @default(cuid())
  folio Int    @unique @default(autoincrement()) // se formatea en la UI como "CT-0001"

  clienteId     String
  cliente       Cliente     @relation(fields: [clienteId], references: [id])
  motocicletaId String
  motocicleta   Motocicleta @relation(fields: [motocicletaId], references: [id])

  valorTotalContrato    Int
  arriendoFijoMensual   Int /// USADO por el motor de cierre
  metaMensualReferencia Int? /// SOLO informativo ("Meta mensual estimada" en la UI) — nunca entra al cálculo
  cuotaDiariaReferencia Int? /// SOLO informativo — nunca entra al cálculo
  frecuenciaPago        FrecuenciaPago @default(MENSUAL) /// SOLO informativo — nunca entra al cálculo

  fechaInicio      DateTime  @db.Date
  fechaFinEstimada DateTime? @db.Date

  saldoCapitalPendiente     Int
  moraAcumulada             Int      @default(0)
  fechaAperturaPeriodoActual DateTime @db.Date

  estado  EstadoContrato @default(ACTIVO)
  version Int            @default(0) // bloqueo optimista en el cierre

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  finalizadoAt DateTime?

  pagos                 Pago[]
  periodosCierre        PeriodoCierre[]
  gastos                Gasto[]
  prestamos             Prestamo[]
  documentos            Documento[]
  notas                 NotaContrato[]
  transferenciasCapital TransferenciaPrestamoCapital[]
  renegociacionComoAnterior RenegociacionContrato? @relation("RenegociacionAnterior")
  renegociacionComoNuevo    RenegociacionContrato? @relation("RenegociacionNuevo")

  @@index([estado])
  @@index([clienteId])
  @@index([motocicletaId])
}

/// Traza cuando un contrato INCUMPLIDO_RECUPERADA se "renegocia" en un contrato
/// nuevo: la deuda pendiente del anterior (capital + mora) se suma al valor del
/// nuevo contrato. El contrato anterior nunca cambia de estado (sigue siendo
/// incumplido en su propio historial); esto solo deja constancia del vínculo.
model RenegociacionContrato {
  id                 String   @id @default(cuid())
  contratoAnteriorId String   @unique
  contratoAnterior   Contrato @relation("RenegociacionAnterior", fields: [contratoAnteriorId], references: [id])
  contratoNuevoId    String   @unique
  contratoNuevo      Contrato @relation("RenegociacionNuevo", fields: [contratoNuevoId], references: [id])

  deudaTrasladada Int // saldoCapitalPendiente + moraAcumulada del contrato anterior al momento de renegociar
  fecha           DateTime @db.Date
  notas           String?

  createdAt DateTime @default(now())
}

/// Bitácora de seguimiento del contrato (notas internas, orden cronológico, sin edición).
model NotaContrato {
  id         String   @id @default(cuid())
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id])
  /// Si la nota es una corrección sobre un pago puntual (ej. "el monto real era $X, no $Y"),
  /// queda referenciado aquí. El Pago nunca se edita: esto es solo trazabilidad adicional.
  pagoId     String?
  pago       Pago?    @relation(fields: [pagoId], references: [id])
  contenido  String
  createdAt  DateTime @default(now())

  @@index([contratoId])
  @@index([pagoId])
}

// ==================== CUENTAS Y MÉTODOS DE PAGO (configuración, trazabilidad de dinero) ====================

/// Una cuenta real (bancaria o efectivo) a la que llega el dinero de uno o más métodos de pago.
/// El saldo "que debe haber" = saldoInicial + pagos recibidos - gastos pagados con métodos de esta cuenta.
model Cuenta {
  id           String   @id @default(cuid())
  nombre       String
  titular      String
  banco        String?
  numeroCuenta String?
  saldoInicial Int      @default(0)
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  metodosPago MetodoPago[]

  @@index([activa])
}

/// Configurable desde Configuración — reemplaza el enum fijo de antes. Cada método
/// apunta a la cuenta real donde entra/sale ese dinero.
model MetodoPago {
  id        String   @id @default(cuid())
  nombre    String
  cuentaId  String
  cuenta    Cuenta   @relation(fields: [cuentaId], references: [id])
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pagos  Pago[]
  gastos Gasto[]

  @@index([cuentaId])
  @@index([activo])
}

// ==================== PAGO Y PERIODO DE CIERRE (el ledger) ====================

enum TipoPago {
  ARRIENDO
  /// Abono directo al saldo de capital: se aplica de inmediato (no espera al cierre de periodo)
  /// y nunca se cuenta dentro de `cobradoPeriodo`. Ver src/server/engine/abonoCapitalService.ts.
  ABONO_CAPITAL
}

model Pago {
  id              String         @id @default(cuid())
  contratoId      String
  contrato        Contrato       @relation(fields: [contratoId], references: [id])
  periodoCierreId String? // null = periodo abierto; se fija al cerrar y nunca cambia
  periodoCierre   PeriodoCierre? @relation(fields: [periodoCierreId], references: [id])

  tipo         TipoPago @default(ARRIENDO)
  fecha        DateTime @db.Date // fecha real del pago (puede ser retroactiva)
  monto        Int
  metodoPagoId String
  metodoPago   MetodoPago @relation(fields: [metodoPagoId], references: [id])
  referencia   String?
  notas        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentos Documento[] // comprobante(s), opcional
  notasCorreccion NotaContrato[]

  @@index([contratoId, periodoCierreId])
  @@index([fecha])
}

enum TipoCierre {
  NORMAL
  COMPRA_ANTICIPADA
}

model PeriodoCierre {
  id            String     @id @default(cuid())
  contratoId    String
  contrato      Contrato   @relation(fields: [contratoId], references: [id])
  numeroPeriodo Int
  tipoCierre    TipoCierre @default(NORMAL)

  fechaAperturaPeriodo DateTime @db.Date
  fechaCierre          DateTime @default(now())

  // snapshot inmutable de todo lo usado en el cálculo (auditable aunque el
  // arriendo fijo del contrato cambie después):
  moraAnterior         Int
  arriendoFijoUsado    Int
  metaArriendo         Int
  cobradoPeriodo       Int
  arriendoCubierto     Int
  abonoCapital         Int
  moraNueva            Int
  saldoCapitalAnterior Int
  saldoCapitalNuevo    Int
  excedenteNoAplicado  Int     @default(0) // solo relevante en COMPRA_ANTICIPADA
  contratoFinalizado   Boolean @default(false)

  createdAt DateTime @default(now())

  pagos      Pago[]
  documentos Documento[] // el PDF del recibo generado

  @@unique([contratoId, numeroPeriodo])
  @@index([contratoId])
}

// ==================== GASTO (solo reportería, no afecta al cliente) ====================

enum CategoriaGasto {
  MANTENIMIENTO
  REPARACION
  SEGURO
  IMPUESTOS
  OTRO
}

model Gasto {
  id            String         @id @default(cuid())
  motocicletaId String
  motocicleta   Motocicleta    @relation(fields: [motocicletaId], references: [id])
  contratoId    String?
  contrato      Contrato?      @relation(fields: [contratoId], references: [id])

  fecha       DateTime       @db.Date
  categoria   CategoriaGasto @default(MANTENIMIENTO)
  descripcion String
  monto       Int

  /// Opcional: de qué cuenta salió este gasto. Nulo en gastos anteriores a esta función.
  metodoPagoId String?
  metodoPago   MetodoPago? @relation(fields: [metodoPagoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documentos Documento[]

  @@index([motocicletaId])
  @@index([contratoId])
  @@index([metodoPagoId])
}

// ==================== PRÉSTAMO (ledger 100% independiente) ====================

enum EstadoPrestamo {
  ACTIVO
  PAGADO
}

model Prestamo {
  id            String       @id @default(cuid())
  clienteId     String
  cliente       Cliente      @relation(fields: [clienteId], references: [id])
  motocicletaId String?
  motocicleta   Motocicleta? @relation(fields: [motocicletaId], references: [id])
  contratoId    String? // solo referencia informativa, sin ligarse al ledger de arriendo
  contrato      Contrato?    @relation(fields: [contratoId], references: [id])

  fecha          DateTime       @db.Date
  montoOriginal  Int
  saldoPendiente Int
  motivo         String?
  estado         EstadoPrestamo @default(ACTIVO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  abonos               AbonoPrestamo[]
  documentos           Documento[]
  transferenciasCapital TransferenciaPrestamoCapital[]

  @@index([clienteId])
}

model AbonoPrestamo {
  id         String   @id @default(cuid())
  prestamoId String
  prestamo   Prestamo @relation(fields: [prestamoId], references: [id])

  fecha DateTime @db.Date
  monto Int

  createdAt DateTime @default(now())

  documentos Documento[]

  @@index([prestamoId])
}

/// Traza el traslado de saldo de un Prestamo hacia el capital de un Contrato: no
/// entra dinero nuevo, se mueve deuda de un ledger a otro. `Prestamo.saldoPendiente`
/// baja y `Contrato.saldoCapitalPendiente` + `Contrato.valorTotalContrato` suben en
/// la misma cantidad (ver transferenciaCapitalService.ts). Nunca se edita ni se borra.
model TransferenciaPrestamoCapital {
  id         String   @id @default(cuid())
  prestamoId String
  prestamo   Prestamo @relation(fields: [prestamoId], references: [id])
  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id])

  monto Int
  fecha DateTime @db.Date
  notas String?

  createdAt DateTime @default(now())

  @@index([prestamoId])
  @@index([contratoId])
}

// ==================== DOCUMENTO (adjuntos genéricos) ====================

enum TipoArchivo {
  CEDULA
  COMPROBANTE_PAGO
  CONTRATO_FIRMADO
  RECIBO_PERIODO
  SOPORTE_GASTO
  SOPORTE_PRESTAMO
  OTRO
}

model Documento {
  id                 String      @id @default(cuid())
  tipo               TipoArchivo
  nombreOriginal     String
  rutaAlmacenamiento String
  mimeType           String
  tamanioBytes       Int

  clienteId       String?
  cliente         Cliente?       @relation(fields: [clienteId], references: [id])
  contratoId      String?
  contrato        Contrato?      @relation(fields: [contratoId], references: [id])
  pagoId          String?
  pago            Pago?          @relation(fields: [pagoId], references: [id])
  periodoCierreId String?
  periodoCierre   PeriodoCierre? @relation(fields: [periodoCierreId], references: [id])
  gastoId         String?
  gasto           Gasto?         @relation(fields: [gastoId], references: [id])
  prestamoId      String?
  prestamo        Prestamo?      @relation(fields: [prestamoId], references: [id])
  abonoPrestamoId String?
  abonoPrestamo   AbonoPrestamo? @relation(fields: [abonoPrestamoId], references: [id])

  createdAt DateTime @default(now())

  @@index([contratoId])
  @@index([clienteId])
}
